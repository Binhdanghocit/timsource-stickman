[Unit]
Description=Stickman browser game
After=network.target

[Service]
Type=simple
User=stickman
Group=stickman
WorkingDirectory=/opt/stickman/game
Environment=NODE_ENV=production
Environment=PORT=8080
ExecStart=/usr/bin/node /opt/stickman/game/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
